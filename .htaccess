# Enable mod_rewrite, start rewrite engine 
Options +FollowSymLinks
RewriteEngine on

# Block source code viewing
RewriteRule "(^|/)(CVS|\.svn|\.git)/" - [F]

RewriteRule ^success(/)*$ success.php [NC]
RewriteRule ^live-design-audit(/)*$ live-audit-landing.php [NC]
RewriteRule ^office-hours(/)*$ /live-design-audit [R=301,L]